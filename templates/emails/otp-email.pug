extends ./layout.pug

block content
  p(style="margin:0 0 16px;font-size:16px;line-height:1.7;") Hi #{recipientName || 'there'},
  p(style="margin:0 0 20px;font-size:16px;line-height:1.7;") Use OTP below to complete your signup. Code valid for #{expiryMinutes} min.
  table(role="presentation" cellspacing="0" cellpadding="0" style="margin:0 0 24px;")
    tr
      td(style="background:#f4f1ea;border:1px dashed #c9bba5;border-radius:16px;padding:16px 24px;font-size:30px;font-weight:700;letter-spacing:10px;")
        | #{otp}
  p(style="margin:0 0 12px;font-size:15px;line-height:1.7;") Email: #{email}
  if mobile
    p(style="margin:0 0 12px;font-size:15px;line-height:1.7;") Mobile: #{mobile}
  p(style="margin:0;font-size:14px;line-height:1.7;color:#666;") If you did not request this, ignore email.
